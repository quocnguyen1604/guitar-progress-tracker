{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "electron"],
    "outDir": "dist-electron",
    "rootDir": "."
  },
  "include": ["electron/**/*.ts", "src/shared/**/*.ts"]
}
