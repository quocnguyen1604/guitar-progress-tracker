{
  "name": "guitar-progress-tracker",
  "description": "A desktop app for tracking guitar practice progress with Discord Rich Presence.",
  "private": false,
  "version": "0.1.0",
  "author": "Hans.005",
  "license": "MIT",
  "homepage": "https://github.com/quocn/guitar-progress-tracker",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:build\" \"npm:dev:electron:run\"",
    "dev:renderer": "vite --port 5173 --strictPort",
    "dev:electron:build": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:run": "wait-on tcp:5173 file:dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electronmon dist-electron/electron/main.js",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron dist-electron/electron/main.js",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native:all": "electron-rebuild -f",
    "rebuild:native:node": "npm rebuild better-sqlite3",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc -b && vite build",
    "build:app": "npm run build && npm run build:electron",
    "start": "electron dist-electron/electron/main.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:win": "npm run build:app && electron-builder --win --dir",
    "dist:win": "npm run build:app && electron-builder --win nsis",
    "release:check": "npm run lint && npm run test && npm run build:app"
  },
  "build": {
    "appId": "com.quocn.guitarprogresstracker",
    "productName": "Guitar Progress Tracker",
    "copyright": "Copyright (c) 2026 Hans.005",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/preload.cjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "legalTrademarks": "Guitar Progress Tracker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "uninstallDisplayName": "Guitar Progress Tracker",
      "license": "build/installer-license.txt"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "better-sqlite3": "^12.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-router-dom": "^7.14.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4",
    "wait-on": "^9.0.5"
  }
}
